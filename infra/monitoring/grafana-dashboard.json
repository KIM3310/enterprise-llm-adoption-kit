{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Enterprise LLM Adoption Kit - Production Observability",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "iteration": 1700000000000,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Request Overview",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Total Requests",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(requests_total)",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Request Rate (5m)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(requests_total[5m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Error Rate (5m)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(requests_total{status!=\"ok\"}[5m])) / sum(rate(requests_total[5m]))",
          "legendFormat": "Error %"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "LLM Cost (Total)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(llm_cost_usd_total)",
          "legendFormat": "USD"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "title": "Request Rate by Endpoint",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(requests_total[5m]))",
          "legendFormat": "{{ endpoint }}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "title": "Request Latency P50 / P95 / P99",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(request_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(request_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(request_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "LLM Provider",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "id": 7,
      "title": "Token Usage (Input vs Output)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(llm_tokens_in_total[5m]))",
          "legendFormat": "Input tokens/s"
        },
        {
          "expr": "sum(rate(llm_tokens_out_total[5m]))",
          "legendFormat": "Output tokens/s"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "id": 8,
      "title": "LLM Failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (provider) (rate(llm_failures_total[5m]))",
          "legendFormat": "{{ provider }}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "id": 9,
      "title": "Circuit Breaker Events",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (event) (rate(llm_circuit_events_total[5m]))",
          "legendFormat": "{{ event }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Policy & Safety",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 10,
      "title": "Policy Events by Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (event) (rate(policy_events_total[5m]))",
          "legendFormat": "{{ event }}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 11,
      "title": "LLM Cost Rate (USD/min)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" }
      },
      "targets": [
        {
          "expr": "sum(rate(llm_cost_usd_total[5m])) * 60",
          "legendFormat": "USD/min"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 103,
      "title": "Request Breakdown",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 12,
      "title": "Requests by Role",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (role) (requests_total)",
          "legendFormat": "{{ role }}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 13,
      "title": "Requests by Use Case",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (use_case) (requests_total)",
          "legendFormat": "{{ use_case }}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["llm", "enterprise", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Enterprise LLM Adoption Kit",
  "uid": "enterprise-llm-adoption-kit",
  "version": 1
}
