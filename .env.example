# =============================================================================
# Enterprise LLM Adoption Kit - Environment Variables
# =============================================================================
# Copy this file to .env and fill in values for your deployment.
# All variables are optional unless noted. The app runs with safe defaults.

# --- Application ---
# APP_NAME="Enterprise LLM Adoption Kit"

# --- Authentication ---
AUTH_MODE=local_jwt                     # local_jwt | oidc
JWT_SECRET=dev-secret-change            # CHANGE in production
JWT_ACTIVE_KID=v1
# JWT_SECRETS="v1:secret1,v2:secret2"  # Key rotation support
# JWT_SECRETS_FILE=/run/secrets/jwt_secrets.json
JWT_ISSUER=enterprise-llm-adoption-kit
JWT_TTL_MINUTES=60
# DEMO_LOGIN_CODE=                     # Shared login code for demo hardening

# --- OIDC (when AUTH_MODE=oidc) ---
# OIDC_ISSUER=https://accounts.google.com
# OIDC_AUDIENCE=your-client-id
# OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# OIDC_ALGORITHMS=RS256

# --- LLM Provider ---
LLM_PROVIDER=stub                       # stub | openai | openai_compatible | ollama | bedrock
LLM_MODEL=stub-llm
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SEC=30
# LLM_OPENAI_API_KEY=sk-...
# LLM_OPENAI_API_KEY_FILE=/run/secrets/openai_key
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_ORG=
# LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_BEDROCK_REGION=us-east-1
LLM_FALLBACK_TO_STUB_ON_ERROR=true
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SEC=30

# --- Cost tracking ---
COST_PER_1K_INPUT_TOKENS=0.003
COST_PER_1K_OUTPUT_TOKENS=0.015

# --- Storage ---
# CHROMA_PERSIST_DIR=./data/chroma
# SQLITE_PATH=./data/app.db
# EVENT_STORAGE_BACKEND=sqlite          # sqlite | jsonl
# SERVICE_EVENTS_JSONL_PATH=./data/service_events.jsonl
# CONTROL_TOWER_DECISIONS_JSONL_PATH=./data/control_tower_decisions.jsonl
# DAILY_COST_JSON_PATH=./data/daily_costs.json

# --- Audit ---
# AUDIT_LOG_PATH=./data/audit.log
AUDIT_SUMMARY_MAX_LINES=5000
DATA_HANDLING_MODE=demo                 # demo | enterprise (enterprise hashes PII)
AUDIT_RETENTION_DAYS=30

# --- Rate limiting ---
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=0.5
LOGIN_ATTEMPT_CAPACITY=10
LOGIN_ATTEMPT_REFILL_PER_SEC=0.1

# --- Request guardrails ---
REQUEST_MAX_BODY_BYTES=262144

# --- Integration auth ---
INTEGRATIONS_REQUIRE_AUTH=true

# --- Tool allowlist ---
# ALLOWED_TOOLS=runbook_lookup,log_signature_extract,knowledge_search

# --- Ops alerts ---
OPS_ALERT_MIN_REQUESTS=20
OPS_ALERT_REFUSAL_RATIO_THRESHOLD=0.2
OPS_ALERT_INJECTION_RATIO_THRESHOLD=0.1
OPS_ALERT_DAILY_COST_THRESHOLD_USD=50.0
# OPS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
OPS_ALERT_WEBHOOK_TIMEOUT_SEC=5.0

# --- OpenTelemetry (opt-in) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Control Tower ---
# CONTROL_TOWER_SPEC_PATH=./data/control_tower_spec.json

# =============================================================================
# Snowflake Integration (env-var gated)
# =============================================================================
# Activated when SNOWFLAKE_ACCOUNT is set. Stores eval results and audit logs.
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=llm_service_account
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PASSWORD_FILE=/run/secrets/snowflake_password
# SNOWFLAKE_DATABASE=LLM_OPS
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=LLM_WRITER

# =============================================================================
# Databricks Integration (env-var gated)
# =============================================================================
# Activated when DATABRICKS_HOST is set. MLflow tracking + Delta audit tables.
# DATABRICKS_HOST=https://dbc-abc123.cloud.databricks.com
# DATABRICKS_AUTH_TYPE=databricks-cli
# DATABRICKS_CONFIG_PROFILE=portfolio-databricks
# DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# DATABRICKS_CLIENT_SECRET=your-service-principal-secret
# DATABRICKS_TOKEN=dapi...
# DATABRICKS_TOKEN_FILE=/run/secrets/databricks_token
# DATABRICKS_WAREHOUSE_ID=abc123
# MLFLOW_EXPERIMENT_NAME=enterprise-llm-eval
# DATABRICKS_CATALOG=workspace
# DATABRICKS_DELTA_SCHEMA=llm_ops

# =============================================================================
# Datadog Integration (opt-in)
# =============================================================================
# DD_API_KEY=
# DD_APP_KEY=
# DD_SITE=datadoghq.com
# DD_SERVICE=enterprise-llm-adoption-kit
# DD_ENV=production
# DD_TRACE_ENABLED=false
